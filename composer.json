{
	"name": "willnorris/wordpress-hum",
	"description": "Personal URL shortener for WordPress",
	"require": {
	  "php": ">=7.4",
	  "composer/installers": "^1.0 || ^2.0"
	},
	"type": "wordpress-plugin",
	"license": "MIT",
	"authors": [
	  {
		"name": "Will Norris",
		"homepage": "https://willnorris.com/"
	  },
	  {
		"name": "Matthias Pfefferle",
		"homepage": "https://notiz.blog/"
	  }
	],
	"extra": {
	  "installer-name": "hum"
	},
	"require-dev": {
	  "phpunit/phpunit": "^9.6.33",
	  "yoast/phpunit-polyfills": "^4.0",
	  "phpcompatibility/php-compatibility": "*",
	  "phpcompatibility/phpcompatibility-wp": "*",
	  "squizlabs/php_codesniffer": "3.*",
	  "wp-coding-standards/wpcs": "*",
	  "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0"
	},
	"scripts": {
	  "lint": "./vendor/bin/phpcs -n -q",
	  "lint:fix": "./vendor/bin/phpcbf",
	  "phpunit": "./vendor/bin/phpunit",
	  "test": [
		"composer install",
		"bin/install-wp-tests.sh hum-test root hum-test test-db latest true",
		"vendor/bin/phpunit"
	  ],
	  "test:wp-env": [
		"wp-env run tests-cli --env-cwd=\"wp-content/plugins/hum\" vendor/bin/phpunit"
	  ]
	},
	"config": {
	  "allow-plugins": {
		"dealerdirect/phpcodesniffer-composer-installer": true,
		"composer/installers": true
	  }
	}
  }