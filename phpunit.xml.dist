<?xml version="1.0"?>
<phpunit
	bootstrap="tests/phpunit/bootstrap.php"
	backupGlobals="false"
	colors="true"
	>
	<testsuites>
		<testsuite name="Hum">
			<directory prefix="class-test-" suffix=".php">./tests/phpunit/tests</directory>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<file>./hum.php</file>
		</include>
	</coverage>
</phpunit>
